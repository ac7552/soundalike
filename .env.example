# Copy to .env and fill in what you have. Everything here is optional:
# with nothing set, the app still works using Deezer's artist radio.

# Last.fm API key (free). Gives track-level "similar songs".
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# AudD API token. Switches on "Listen to what's playing".
# A free allowance, then paid per request: https://audd.io
AUDD_API_TOKEN=

# Address of the optional audio worker (see worker/). Empty means off.
# RERANK_URL=http://127.0.0.1:4100
RERANK_URL=

# How much the audio score counts against Last.fm's order, from 0 to 1.
RERANK_WEIGHT=0.6
